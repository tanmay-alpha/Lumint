# Lumint backend — environment variables.
#
# Copy this file to `.env` for local dev:    cp .env.example .env
# NEVER commit the real `.env` — it is in `.gitignore`.
# In production, set these in your host's env-var UI (Render, Vercel, etc.).

# --- App ---
APP_NAME=Lumint
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# --- Database ---
DATABASE_URL=sqlite+pysqlite:///./backend/data/lumint_dev.db

# --- AI providers (optional) ---
GROQ_API_KEY=your_groq_key_here

# --- CORS ---
# JSON array or comma-separated string. Default when unset:
#   ["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_ORIGINS=[]

# --- Auth ---
JWT_SECRET=replace_me_with_random_64_char_hex

# --- ML ---
ML_MODEL_PATH=./ml/models
